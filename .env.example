# Network
HOST=127.0.0.1
PORT=8000
RELOAD=false
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Required local translation artifacts
INDICTRANS2_EN_INDIC=@PROJECT_DIR@/models/indictrans2-en-indic-dist-200M-ct2-int8
INDICTRANS2_INDIC_EN=@PROJECT_DIR@/models/indictrans2-indic-en-dist-200M-ct2-int8

# Required local Faster Whisper snapshot
WHISPER_MODEL_PATH=@PROJECT_DIR@/models/faster-whisper-base
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_NUM_WORKERS=1

# Required local PaddleOCR tree: rec/, det/, cls/
OCR_MODEL_ROOT=@PROJECT_DIR@/models/paddleocr/whl
OCR_ENABLE_MKLDNN=false
OCR_CPU_THREADS=4

# Required local Piper voices. Each .onnx must have an adjacent .onnx.json.
PIPER_VOICES_DIR=@PROJECT_DIR@/models/piper
# Use this instead when more than one voice matches a language prefix:
# PIPER_VOICE_MAP={"eng_Latn":"@PROJECT_DIR@/models/piper/en_US-lessac-medium.onnx"}

# Writable runtime storage
UPLOAD_DIR=/var/tmp/ai-translator/uploads
