# Local environment configuration. Keep the distributable template tracked.
.env
.env.*
!.env.example

# Local model artifacts and checkpoints.
/models/
/checkpoints/

# Python virtual environments.
.venv/
venv/
env/
ENV/

# Python caches, test caches, and local coverage output.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Python build and packaging output.
build/
dist/
.eggs/
*.egg-info/

# JavaScript dependencies.
node_modules/

# Generated runtime output and uploaded files.
output/
outputs/
generated/
uploads/

# Temporary files and logs.
*.log
logs/
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig

# Editor and operating-system metadata.
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db